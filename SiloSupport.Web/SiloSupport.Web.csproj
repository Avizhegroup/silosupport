<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
        <!-- Version comes from Directory.Packages.props. Restores from the Telerik feed / local package folder in NuGet.Config. -->
        <PackageReference Include="Telerik.UI.for.Blazor" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The Web project only shows and manages data: no Bale / AI adapters (those live in SiloSupport.Service.CustomerSupport). -->
        <ProjectReference Include="..\SiloSupport.Application\SiloSupport.Application.csproj" />
        <ProjectReference Include="..\SiloSupport.Persistence\SiloSupport.Persistence.csproj" />
    </ItemGroup>

</Project>
