@page "/admin/customers/{CustomerId:int}/members/new"
@page "/admin/customers/{CustomerId:int}/members/{MemberId:int}/edit"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@inject CustomerService Customers
@inject CustomerMemberService Members
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "عضو جدید" : "ویرایش عضو")</PageTitle>

@if (_error is not null && _model is null)
{
    <div class="banner banner-error">@_error</div>
    <LinkButton Href="/admin/customers">بازگشت به مشتریان</LinkButton>
}
else if (_model is null || _customer is null)
{
    <div class="loading-state">در حال بارگذاری…</div>
}
else
{
    <div class="page-header">
        <h1>@(IsNew ? "عضو جدید" : "ویرایش عضو")</h1>
    </div>
    <p>مشتری: <strong>@_customer.Name</strong></p>

    <div class="panel form-panel">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="form-row">
                <label>نام</label>
                <TelerikTextBox @bind-Value="_model.Name" Width="100%" />
                <ValidationMessage For="() => _model.Name" />
            </div>
            <div class="form-row">
                <label>شماره تلفن</label>
                <TelerikTextBox @bind-Value="_model.PhoneNumber" Width="100%" />
                <ValidationMessage For="() => _model.PhoneNumber" />
            </div>
            <div class="form-row">
                <label>شناسه بله (نام کاربری یا شناسه عددی)</label>
                <div dir="ltr">
                    <TelerikTextBox @bind-Value="_model.BaleId" Width="100%" />
                </div>
                <div class="hint">نام کاربری بله مثل <bdi dir="ltr">&#64;ali</bdi> یا شناسه عددی کاربر را وارد کنید؛ پیام‌های فرستنده با هر دو روش شناسایی می‌شوند. حروف بزرگ و کوچک و علامت <bdi dir="ltr">&#64;</bdi> تأثیری ندارند و مقدار باید در میان همه اعضا یکتا باشد.</div>
                <ValidationMessage For="() => _model.BaleId" />
            </div>
            <div class="form-row">
                <label>توضیحات</label>
                <TelerikTextArea @bind-Value="_model.Description" Width="100%" />
                <ValidationMessage For="() => _model.Description" />
            </div>

            <StatusBanner Message="@ErrorText" IsError="true" />

            <div class="form-actions">
                <TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="!_saving">ذخیره</TelerikButton>
                <LinkButton Href="@($"/admin/customers/{CustomerId}")">انصراف</LinkButton>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int CustomerId { get; set; }

    [Parameter] public int? MemberId { get; set; }

    private CustomerDto? _customer;
    private MemberInput? _model;
    private List<string> _errors = new();
    private string? _error;
    private bool _saving;

    private string ErrorText => string.Join(" ", _errors);

    private bool IsNew => MemberId is null;

    protected override async Task OnParametersSetAsync()
    {
        _errors.Clear();
        _error = null;
        _customer = await Customers.GetAsync(CustomerId);
        if (_customer is null)
        {
            _model = null;
            _error = "مشتری وجود ندارد.";
            return;
        }

        if (IsNew)
        {
            _model = new MemberInput();
            return;
        }

        var member = await Members.GetAsync(MemberId!.Value);

        // The member must belong to the customer in the URL.
        if (member is null || member.CustomerId != CustomerId)
        {
            _model = null;
            _error = "این عضو برای این مشتری وجود ندارد.";
            return;
        }

        _model = new MemberInput
        {
            Name = member.Name,
            Description = member.Description,
            PhoneNumber = member.PhoneNumber,
            BaleId = member.BaleId
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errors.Clear();
        try
        {
            var result = IsNew
                ? await Members.CreateAsync(CustomerId, _model!)
                : await Members.UpdateAsync(MemberId!.Value, _model!);

            if (!result.Succeeded)
            {
                _errors = result.Errors.ToList();
                return;
            }

            Navigation.NavigateTo($"/admin/customers/{CustomerId}");
        }
        finally
        {
            _saving = false;
        }
    }
}
