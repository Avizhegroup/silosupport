@page "/admin/customers/{Id:int}"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@inject CustomerService Customers
@inject CustomerMemberService Members
@inject CustomerGroupService Groups

<PageTitle>@(_details?.Customer.Name ?? "مشتری")</PageTitle>

@if (_loaded && _details is null)
{
    <div class="banner banner-error">مشتری وجود ندارد.</div>
    <LinkButton Href="/admin/customers">بازگشت به مشتریان</LinkButton>
}
else if (_details is null)
{
    <div class="loading-state">در حال بارگذاری…</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@_details.Customer.Name</h1>
            <p class="page-sub">@(string.IsNullOrWhiteSpace(_details.Customer.Description) ? "بدون توضیحات." : _details.Customer.Description)</p>
        </div>
        <div class="page-actions">
            <LinkButton Href="@($"/admin/conversations/{Id}")">گفتگوها</LinkButton>
            <LinkButton Href="@($"/admin/customers/{Id}/edit")">ویرایش</LinkButton>
            <LinkButton Href="/admin/customers">بازگشت</LinkButton>
        </div>
    </div>

    <StatusBanner Message="@_message" IsError="_isError" />
    <MissingPriorityAlert Missing="_details.MissingPriorities" />

    <div class="panel">
        <div class="panel-head">
            <h2>اعضای @_details.Customer.Name</h2>
            <LinkButton Href="@($"/admin/customers/{Id}/members/new")" Primary="true">افزودن عضو</LinkButton>
        </div>

        @if (_details.Members.Count == 0)
        {
            <div class="empty-state">
                <TelerikSvgIcon Icon="@SvgIcon.User" />
                <strong>این مشتری عضوی ندارد</strong>
                <span>پیام فرستنده‌های ثبت‌نشده نادیده گرفته می‌شود.</span>
            </div>
        }
        else
        {
            <TelerikGrid Data="_details.Members" TItem="MemberDto" Sortable="true">
                <GridColumns>
                    <GridColumn Field="@nameof(MemberDto.Name)" Title="نام" />
                    <GridColumn Field="@nameof(MemberDto.PhoneNumber)" Title="تلفن" />
                    <GridColumn Field="@nameof(MemberDto.BaleId)" Title="شناسه بله">
                        <Template>
                            @{ var m = (MemberDto)context; }
                            <bdi dir="ltr">@m.BaleId</bdi>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(MemberDto.Description)" Title="توضیحات" />
                    <GridColumn Title="عملیات" Width="220px" Sortable="false">
                        <Template>
                            @{ var m = (MemberDto)context; }
                            <div class="row-actions">
                                <LinkButton Href="@($"/admin/customers/{Id}/members/{m.Id}/edit")">ویرایش</LinkButton>
                                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" OnClick="@(() => AskDeleteMember(m))">حذف</TelerikButton>
                            </div>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        }
    </div>

    <div class="panel">
        <h2>گروه‌های مقصد بر اساس اولویت</h2>
        <p class="muted">برای هر اولویت یک گروه بله تعریف می‌شود. پیام‌های طبقه‌بندی‌شده به گروه اولویت خود ارسال می‌شوند.</p>

        <TelerikGrid Data="_details.PriorityGroups" TItem="PriorityGroupStatusDto">
            <GridColumns>
                <GridColumn Title="اولویت" Width="140px">
                    <Template>
                        @{ var s = (PriorityGroupStatusDto)context; }
                        <PriorityChip Priority="s.Priority" />
                    </Template>
                </GridColumn>
                <GridColumn Title="نام گروه">
                    <Template>
                        @{ var s = (PriorityGroupStatusDto)context; }
                        @if (s.Group is not null)
                        {
                            @s.Group.Name
                        }
                        else
                        {
                            <span class="chip chip-warn">تنظیم نشده</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Title="شناسه گروه بله">
                    <Template>
                        @{ var s = (PriorityGroupStatusDto)context; }
                        @(s.Group?.BaleId.ToString() ?? "")
                    </Template>
                </GridColumn>
                <GridColumn Title="عملیات" Width="220px">
                    <Template>
                        @{ var s = (PriorityGroupStatusDto)context; }
                        <div class="row-actions">
                            @if (s.Group is not null)
                            {
                                var g = s.Group;
                                <LinkButton Href="@($"/admin/customers/{Id}/groups/{g.Id}/edit")">ویرایش</LinkButton>
                                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" OnClick="@(() => AskDeleteGroup(g))">حذف</TelerikButton>
                            }
                            else
                            {
                                <LinkButton Href="@($"/admin/customers/{Id}/groups/new?priority={s.Priority}")" Primary="true">تنظیم</LinkButton>
                            }
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
}

<ConfirmDialog Visible="_memberToDelete is not null"
               Title="حذف عضو"
               Message="@($"عضو «{_memberToDelete?.Name}» حذف شود؟")"
               OnConfirm="DeleteMemberAsync"
               OnCancel="CancelDelete" />

<ConfirmDialog Visible="_groupToDelete is not null"
               Title="حذف گروه اولویت"
               Message="@GroupDeleteMessage"
               OnConfirm="DeleteGroupAsync"
               OnCancel="CancelDelete" />

@code {
    [Parameter] public int Id { get; set; }

    private CustomerDetailsDto? _details;
    private MemberDto? _memberToDelete;
    private GroupDto? _groupToDelete;
    private bool _loaded;

    private string GroupDeleteMessage => _groupToDelete is null
        ? string.Empty
        : $"گروه «{_groupToDelete.Name}» با اولویت «{PriorityHelper.DisplayName(_groupToDelete.Priority)}» حذف شود؟";
    private string? _message;
    private bool _isError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _details = await Customers.GetDetailsAsync(Id);
        _loaded = true;
    }

    private void AskDeleteMember(MemberDto member) => _memberToDelete = member;

    private void AskDeleteGroup(GroupDto group) => _groupToDelete = group;

    private void CancelDelete()
    {
        _memberToDelete = null;
        _groupToDelete = null;
    }

    private async Task DeleteMemberAsync()
    {
        var member = _memberToDelete;
        _memberToDelete = null;
        if (member is null)
            return;

        var result = await Members.DeleteAsync(member.Id);
        _isError = !result.Succeeded;
        _message = result.Succeeded ? "عضو حذف شد." : result.FirstError ?? "حذف عضو انجام نشد.";
        await LoadAsync();
    }

    private async Task DeleteGroupAsync()
    {
        var group = _groupToDelete;
        _groupToDelete = null;
        if (group is null)
            return;

        var result = await Groups.DeleteAsync(group.Id);
        _isError = !result.Succeeded;
        _message = result.Succeeded ? "گروه حذف شد." : result.FirstError ?? "حذف گروه انجام نشد.";
        await LoadAsync();
    }
}
