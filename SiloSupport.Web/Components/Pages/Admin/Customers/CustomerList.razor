@page "/admin/customers"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@inject CustomerService Customers

<PageTitle>مشتریان</PageTitle>

<div class="page-header">
    <div>
        <h1>مشتریان</h1>
        <p class="page-sub">مدیریت مشتریان، اعضا و گروه‌های مقصد</p>
    </div>
    <LinkButton Href="/admin/customers/new" Primary="true">مشتری جدید</LinkButton>
</div>

<StatusBanner Message="@_message" IsError="_isError" />

@if (_items is null)
{
    <div class="loading-state">در حال بارگذاری…</div>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <TelerikSvgIcon Icon="@SvgIcon.User" />
        <strong>هنوز مشتری‌ای ثبت نشده است</strong>
        <span>با دکمه «مشتری جدید» اولین مشتری را ایجاد کنید.</span>
    </div>
}
else
{
    <div class="panel">
    <TelerikGrid Data="_items" TItem="CustomerListItemDto" Sortable="true" Height="600px">
        <GridColumns>
            <GridColumn Field="@nameof(CustomerListItemDto.Name)" Title="نام">
                <Template>
                    @{ var c = (CustomerListItemDto)context; }
                    <a href="/admin/customers/@c.Id">@c.Name</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CustomerListItemDto.Description)" Title="توضیحات" />
            <GridColumn Field="@nameof(CustomerListItemDto.MemberCount)" Title="تعداد اعضا" Width="120px" />
            <GridColumn Title="گروه‌های اولویت" Width="280px" Sortable="false">
                <Template>
                    @{ var c = (CustomerListItemDto)context; }
                    @if (c.MissingPriorities.Count == 0)
                    {
                        <span class="chip chip-ok">کامل (۳ از ۳)</span>
                    }
                    else
                    {
                        <span class="chip chip-warn">تنظیم‌نشده: @string.Join("، ", c.MissingPriorities.Select(PriorityHelper.DisplayName))</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Title="عملیات" Width="300px" Sortable="false">
                <Template>
                    @{ var c = (CustomerListItemDto)context; }
                    <div class="row-actions">
                        <LinkButton Href="@($"/admin/customers/{c.Id}")">جزئیات</LinkButton>
                        <LinkButton Href="@($"/admin/customers/{c.Id}/edit")">ویرایش</LinkButton>
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" OnClick="@(() => AskDelete(c))">حذف</TelerikButton>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>
    </div>
}

<ConfirmDialog Visible="_toDelete is not null"
               Title="حذف مشتری"
               Message="@($"مشتری «{_toDelete?.Name}» همراه با اعضا و گروه‌های اولویت حذف شود؟ این کار قابل بازگشت نیست.")"
               OnConfirm="DeleteAsync"
               OnCancel="CancelDelete" />

@code {
    private List<CustomerListItemDto>? _items;
    private CustomerListItemDto? _toDelete;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _items = (await Customers.GetListAsync()).ToList();

    private void AskDelete(CustomerListItemDto customer) => _toDelete = customer;

    private void CancelDelete() => _toDelete = null;

    private async Task DeleteAsync()
    {
        var customer = _toDelete;
        _toDelete = null;
        if (customer is null)
            return;

        var result = await Customers.DeleteAsync(customer.Id);
        _isError = !result.Succeeded;
        _message = result.Succeeded ? "مشتری حذف شد." : result.FirstError ?? "حذف مشتری انجام نشد.";

        await LoadAsync();
    }
}
