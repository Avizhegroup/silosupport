@page "/admin/conversations"
@page "/admin/conversations/{CustomerId:int}"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@inject CustomerService Customers
@inject ConversationService Conversations
@inject NavigationManager Navigation

<PageTitle>گفتگوها</PageTitle>

<div class="page-header">
    <div>
        <h1>گفتگوهای مشتریان</h1>
        <p class="page-sub">پیام‌های ارسال‌شده به گروه‌های اولویت هر مشتری و وضعیت رسیدگی به آن‌ها</p>
    </div>
</div>

<div class="form-row">
    <label>مشتری</label>
    <TelerikDropDownList Data="_customers" TextField="@nameof(CustomerListItemDto.Name)" ValueField="@nameof(CustomerListItemDto.Id)"
                         Value="_selectedId" ValueChanged="@((int id) => OnCustomerChanged(id))"
                         DefaultText="یک مشتری انتخاب کنید" Width="360px" />
</div>

<StatusBanner Message="@_error" IsError="true" />

@if (CustomerId is null)
{
    <div class="empty-state">
        <TelerikSvgIcon Icon="@SvgIcon.Comment" />
        <strong>یک مشتری انتخاب کنید</strong>
        <span>پیام‌های ارسال‌شده به گروه‌های اولویت او در اینجا نمایش داده می‌شود.</span>
    </div>
}
else if (_loading)
{
    <div class="loading-state">در حال بارگذاری…</div>
}
else if (_conversation is null)
{
    <div class="banner banner-error">مشتری وجود ندارد.</div>
}
else
{
    <MissingPriorityAlert Missing="_conversation.MissingPriorities" />

    @if (_conversation.Groups.Count == 0)
    {
        <div class="banner banner-info">این مشتری هنوز گروه اولویتی ندارد.</div>
    }

    <TelerikTabStrip>
        <TabStripTab Title="موضوعات (پیگیری مکالمه‌ها)">
            @if (_conversation.Threads.Count == 0 && _conversation.LegacyMessages.Count == 0)
            {
                <p class="muted">هنوز موضوعی ثبت نشده است.</p>
            }

            @foreach (var thread in _conversation.Threads)
            {
                <div class="panel thread @(thread.IsOpen ? "thread-open" : "thread-closed")">
                    <div class="panel-head">
                        <div>
                            <h2>@thread.Title <PriorityChip Priority="thread.HighestPriority" /></h2>
                            <span class="muted">
                                @thread.Messages.Count پیام · شروع: @PersianDateFormatter.FormatUtc(thread.CreatedAtUtc) · آخرین فعالیت: @PersianDateFormatter.FormatUtc(thread.LastActivityUtc)
                            </span>
                        </div>
                        <TelerikSwitch Value="!thread.IsOpen" ValueChanged="@((bool value) => SetThreadResolvedAsync(thread, value))"
                                       OnLabel="حل‌شده" OffLabel="در حال رسیدگی" Width="170px" />
                    </div>

                    <ol class="thread-timeline">
                        @foreach (var m in thread.Messages)
                        {
                            <li class="thread-message">
                                <div class="thread-message-meta">
                                    <span>@PersianDateFormatter.FormatUtc(m.CreatedAtUtc)</span>
                                    <PriorityChip Priority="m.Priority" />
                                    <span class="muted">@m.GroupName</span>
                                    @if (m.IsResolved)
                                    {
                                        <span class="muted">· حل‌شده</span>
                                    }
                                </div>
                                <div class="message-text">@m.Message</div>
                                <AttachmentView Attachment="m.Attachment" />
                            </li>
                        }
                    </ol>
                </div>
            }

            @if (_conversation.LegacyMessages.Count > 0)
            {
                <div class="panel">
                    <div class="panel-head">
                        <h2>پیام‌های قدیمی (بدون موضوع)</h2>
                        <span class="muted">@_conversation.LegacyMessages.Count پیام</span>
                    </div>
                    <ol class="thread-timeline">
                        @foreach (var m in _conversation.LegacyMessages)
                        {
                            <li class="thread-message">
                                <div class="thread-message-meta">
                                    <span>@PersianDateFormatter.FormatUtc(m.CreatedAtUtc)</span>
                                    <PriorityChip Priority="m.Priority" />
                                    <span class="muted">@m.GroupName</span>
                                </div>
                                <div class="message-text">@m.Message</div>
                            </li>
                        }
                    </ol>
                </div>
            }
        </TabStripTab>

        <TabStripTab Title="گروه‌های اولویت">
            @foreach (var group in _conversation.Groups)
            {
                <div class="panel">
                    <div class="panel-head">
                        <h2>@group.GroupName <PriorityChip Priority="group.Priority" /></h2>
                        <span class="muted">@group.Messages.Count پیام</span>
                    </div>

                    @if (group.Messages.Count == 0)
                    {
                        <p class="muted">هنوز پیامی به این گروه ارسال نشده است.</p>
                    }
                    else
                    {
                        <TelerikGrid Data="group.Messages" TItem="GroupedMessageDto" Height="@(group.Messages.Count > 6 ? "480px" : null)">
                            <GridColumns>
                                <GridColumn Title="زمان" Width="170px">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        @PersianDateFormatter.FormatUtc(m.CreatedAtUtc)
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="پیام">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        <div class="message-text">@m.Message</div>
                                        <AttachmentView Attachment="m.Attachment" />
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="وضعیت" Width="190px">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        <TelerikSwitch Value="m.IsResolved" ValueChanged="@((bool value) => SetResolvedAsync(m, value))"
                                                       OnLabel="حل‌شده" OffLabel="حل‌نشده" Width="150px" />
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </TelerikGrid>
                    }
                </div>
            }
        </TabStripTab>
    </TelerikTabStrip>
}

@code {
    [Parameter] public int? CustomerId { get; set; }

    private IReadOnlyList<CustomerListItemDto> _customers = Array.Empty<CustomerListItemDto>();
    private CustomerConversationDto? _conversation;
    private bool _loading;
    private string? _error;

    private int _selectedId => CustomerId ?? 0;

    protected override async Task OnInitializedAsync() => _customers = await Customers.GetListAsync();

    protected override async Task OnParametersSetAsync()
    {
        _conversation = null;
        _error = null;
        if (CustomerId is null)
            return;

        // Only the selected customer's messages are loaded (filtered in the database).
        _loading = true;
        try
        {
            _conversation = await Conversations.GetAsync(CustomerId.Value);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnCustomerChanged(int customerId)
    {
        Navigation.NavigateTo(customerId == 0 ? "/admin/conversations" : $"/admin/conversations/{customerId}");
    }

    private async Task SetThreadResolvedAsync(ThreadDto thread, bool isResolved)
    {
        var result = await Conversations.SetThreadResolvedAsync(CustomerId!.Value, thread.Id, isResolved);
        _error = result.Succeeded ? null : result.FirstError ?? "ذخیره وضعیت انجام نشد.";
        _conversation = await Conversations.GetAsync(CustomerId.Value);
    }

    private async Task SetResolvedAsync(GroupedMessageDto message, bool isResolved)
    {
        var result = await Conversations.SetResolvedAsync(CustomerId!.Value, message.Id, isResolved);
        _error = result.Succeeded ? null : result.FirstError ?? "ذخیره وضعیت انجام نشد.";

        // Reload so the page always shows what is persisted.
        _conversation = await Conversations.GetAsync(CustomerId.Value);
    }
}
