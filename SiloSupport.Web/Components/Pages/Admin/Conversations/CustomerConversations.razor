@page "/admin/conversations"
@page "/admin/conversations/{CustomerId:int}"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@inject CustomerService Customers
@inject ConversationService Conversations
@inject NavigationManager Navigation

<PageTitle>گفتگوها</PageTitle>

<div class="page-header">
    <div>
        <h1>گفتگوهای مشتریان</h1>
        <p class="page-sub">هر مشتری چند «موضوع» دارد؛ پیام‌هایی که به یک مسئله مربوط‌اند زیر همان موضوع جمع می‌شوند و تا زمانی که حل‌شده نشوند باز می‌مانند</p>
    </div>
</div>

<div class="form-row">
    <label>مشتری</label>
    <TelerikDropDownList Data="_customers" TextField="@nameof(CustomerListItemDto.Name)" ValueField="@nameof(CustomerListItemDto.Id)"
                         Value="_selectedId" ValueChanged="@((int id) => OnCustomerChanged(id))"
                         DefaultText="یک مشتری انتخاب کنید" Width="360px" />
</div>

<StatusBanner Message="@_error" IsError="true" />

@if (CustomerId is null)
{
    <div class="empty-state">
        <TelerikSvgIcon Icon="@SvgIcon.Comment" />
        <strong>یک مشتری انتخاب کنید</strong>
        <span>موضوع‌ها و گفتگوی هر موضوع در اینجا نمایش داده می‌شود.</span>
    </div>
}
else if (_loading)
{
    <div class="loading-state">در حال بارگذاری…</div>
}
else if (_conversation is null)
{
    <div class="banner banner-error">مشتری وجود ندارد.</div>
}
else
{
    <MissingPriorityAlert Missing="_conversation.MissingPriorities" />

    <div class="stat-grid">
        <div class="stat-tile stat-warn">
            <span class="stat-icon"><TelerikSvgIcon Icon="@SvgIcon.ExclamationCircle" /></span>
            <span class="stat-text">
                <span class="stat-label">موضوعات باز</span>
                <span class="stat-value">@OpenThreadCount</span>
            </span>
        </div>
        <div class="stat-tile stat-ok">
            <span class="stat-icon"><TelerikSvgIcon Icon="@SvgIcon.CheckCircle" /></span>
            <span class="stat-text">
                <span class="stat-label">موضوعات حل‌شده</span>
                <span class="stat-value">@(_conversation.Threads.Count - OpenThreadCount)</span>
            </span>
        </div>
        <div class="stat-tile stat-info">
            <span class="stat-icon"><TelerikSvgIcon Icon="@SvgIcon.Comment" /></span>
            <span class="stat-text">
                <span class="stat-label">کل پیام‌ها</span>
                <span class="stat-value">@TotalMessageCount</span>
            </span>
        </div>
    </div>

    <TelerikTabStrip>
        <TabStripTab Title="موضوعات">
            <div class="thread-toolbar">
                <div class="form-row">
                    <label>وضعیت</label>
                    <TelerikDropDownList Data="_statusItems" TextField="@nameof(FilterItem.Text)" ValueField="@nameof(FilterItem.Value)"
                                         @bind-Value="_status" Width="180px" />
                </div>
                <div class="form-row thread-search">
                    <label>جستجو</label>
                    <TelerikTextBox @bind-Value="_search" Placeholder="عنوان، خلاصه یا متن پیام…" Width="320px" />
                </div>
            </div>

            @if (_conversation.Threads.Count == 0 && _conversation.LegacyMessages.Count == 0)
            {
                <div class="empty-state">
                    <TelerikSvgIcon Icon="@SvgIcon.Comment" />
                    <strong>هنوز موضوعی ثبت نشده است</strong>
                    <span>با دریافت اولین پیام مشتری، موضوع آن ساخته می‌شود.</span>
                </div>
            }
            else if (!VisibleThreads.Any())
            {
                <p class="muted">موضوعی با این فیلتر یافت نشد.</p>
            }

            @foreach (var thread in VisibleThreads)
            {
                var expanded = _expanded.Contains(thread.Id);
                <div class="panel thread @(thread.IsOpen ? "thread-open" : "thread-closed")">
                    <div class="panel-head thread-head">
                        <div class="thread-title">
                            <h2>@thread.Title</h2>
                            <div class="thread-badges">
                                <PriorityChip Priority="thread.HighestPriority" />
                                <span class="status-badge @(thread.IsOpen ? "status-open" : "status-done")">@(thread.IsOpen ? "باز" : "حل‌شده")</span>
                                <span class="muted">@thread.Messages.Count پیام</span>
                            </div>
                            <span class="muted">
                                شروع: @PersianDateFormatter.FormatUtc(thread.CreatedAtUtc) · آخرین فعالیت: @PersianDateFormatter.FormatUtc(thread.LastActivityUtc)
                            </span>
                        </div>
                        <TelerikSwitch Value="!thread.IsOpen" ValueChanged="@((bool value) => SetThreadResolvedAsync(thread, value))"
                                       OnLabel="حل‌شده" OffLabel="در حال رسیدگی" Width="170px" />
                    </div>

                    <div class="thread-summary">
                        <strong>خلاصه موضوع</strong>
                        <p>@(string.IsNullOrWhiteSpace(thread.Summary) ? FallbackSummary(thread) : thread.Summary)</p>
                    </div>

                    <div class="thread-actions">
                        <TelerikButton OnClick="@(() => Toggle(thread.Id))">@(expanded ? "بستن گفتگو" : "نمایش گفتگو")</TelerikButton>
                    </div>

                    @if (expanded)
                    {
                        <Conversation Messages="thread.Messages" />
                    }
                </div>
            }

            @if (_conversation.LegacyMessages.Count > 0)
            {
                <div class="panel thread thread-closed">
                    <div class="panel-head thread-head">
                        <div class="thread-title">
                            <h2>پیام‌های قدیمی (بدون موضوع)</h2>
                            <span class="muted">@_conversation.LegacyMessages.Count پیام که پیش از ساخت موضوع‌ها ثبت شده‌اند</span>
                        </div>
                        <TelerikButton OnClick="@(() => _legacyExpanded = !_legacyExpanded)">@(_legacyExpanded ? "بستن" : "نمایش")</TelerikButton>
                    </div>

                    @if (_legacyExpanded)
                    {
                        <Conversation Messages="_conversation.LegacyMessages" />
                    }
                </div>
            }
        </TabStripTab>

        <TabStripTab Title="بر اساس گروه اولویت">
            @if (_conversation.Groups.Count == 0)
            {
                <div class="banner banner-info">این مشتری هنوز گروه اولویتی ندارد.</div>
            }

            @foreach (var group in _conversation.Groups)
            {
                <div class="panel">
                    <div class="panel-head">
                        <h2>@group.GroupName <PriorityChip Priority="group.Priority" /></h2>
                        <span class="muted">@group.Messages.Count پیام</span>
                    </div>

                    @if (group.Messages.Count == 0)
                    {
                        <p class="muted">هنوز پیامی به این گروه ارسال نشده است.</p>
                    }
                    else
                    {
                        <TelerikGrid Data="group.Messages" TItem="GroupedMessageDto" Height="@(group.Messages.Count > 6 ? "480px" : null)">
                            <GridColumns>
                                <GridColumn Title="زمان" Width="170px">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        @PersianDateFormatter.FormatUtc(m.CreatedAtUtc)
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="پیام">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        <div class="message-text">@m.Message</div>
                                        <AttachmentView Attachment="m.Attachment" />
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="وضعیت" Width="190px">
                                    <Template>
                                        @{ var m = (GroupedMessageDto)context; }
                                        <TelerikSwitch Value="m.IsResolved" ValueChanged="@((bool value) => SetResolvedAsync(m, value))"
                                                       OnLabel="حل‌شده" OffLabel="حل‌نشده" Width="150px" />
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </TelerikGrid>
                    }
                </div>
            }
        </TabStripTab>
    </TelerikTabStrip>
}

@code {
    private sealed record FilterItem(string Value, string Text);

    [Parameter] public int? CustomerId { get; set; }

    private static readonly IReadOnlyList<FilterItem> _statusItems = new[]
    {
        new FilterItem("all", "همه موضوعات"),
        new FilterItem("open", "فقط باز"),
        new FilterItem("resolved", "فقط حل‌شده")
    };

    private IReadOnlyList<CustomerListItemDto> _customers = Array.Empty<CustomerListItemDto>();
    private CustomerConversationDto? _conversation;
    private readonly HashSet<int> _expanded = new();
    private bool _legacyExpanded;
    private bool _loading;
    private string? _error;
    private string _status = "all";
    private string? _search;

    private int _selectedId => CustomerId ?? 0;

    private int OpenThreadCount => _conversation?.Threads.Count(t => t.IsOpen) ?? 0;

    private int TotalMessageCount => _conversation is null
        ? 0
        : _conversation.Threads.Sum(t => t.Messages.Count) + _conversation.LegacyMessages.Count;

    private IEnumerable<ThreadDto> VisibleThreads =>
        (_conversation?.Threads ?? Array.Empty<ThreadDto>())
            .Where(t => _status == "all" || (_status == "open") == t.IsOpen)
            .Where(Matches);

    protected override async Task OnInitializedAsync() => _customers = await Customers.GetListAsync();

    protected override async Task OnParametersSetAsync()
    {
        _conversation = null;
        _error = null;
        _expanded.Clear();
        _legacyExpanded = false;
        if (CustomerId is null)
            return;

        // Only the selected customer's messages are loaded (filtered in the database).
        _loading = true;
        try
        {
            _conversation = await Conversations.GetAsync(CustomerId.Value);

            // The most recently active open issue starts expanded so the page opens on what needs attention.
            var first = _conversation?.Threads.FirstOrDefault(t => t.IsOpen);
            if (first is not null)
                _expanded.Add(first.Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnCustomerChanged(int customerId)
    {
        Navigation.NavigateTo(customerId == 0 ? "/admin/conversations" : $"/admin/conversations/{customerId}");
    }

    private void Toggle(int threadId)
    {
        if (!_expanded.Remove(threadId))
            _expanded.Add(threadId);
    }

    private bool Matches(ThreadDto thread)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var term = _search.Trim();
        return Contains(thread.Title, term)
               || Contains(thread.Summary, term)
               || thread.Messages.Any(m => Contains(m.OriginalText ?? m.Message, term));
    }

    private static bool Contains(string? text, string term) =>
        text is not null && text.Contains(term, StringComparison.CurrentCultureIgnoreCase);

    /// <summary>Issues created before summaries existed show the first customer text instead.</summary>
    private static string FallbackSummary(ThreadDto thread)
    {
        var first = thread.Messages.Select(m => m.OriginalText).FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));
        if (first is null)
            return "خلاصه‌ای برای این موضوع ثبت نشده است.";

        return first.Length <= 240 ? first : first.Substring(0, 239) + "…";
    }

    private async Task SetThreadResolvedAsync(ThreadDto thread, bool isResolved)
    {
        var result = await Conversations.SetThreadResolvedAsync(CustomerId!.Value, thread.Id, isResolved);
        _error = result.Succeeded ? null : result.FirstError ?? "ذخیره وضعیت انجام نشد.";
        _conversation = await Conversations.GetAsync(CustomerId.Value);
    }

    private async Task SetResolvedAsync(GroupedMessageDto message, bool isResolved)
    {
        var result = await Conversations.SetResolvedAsync(CustomerId!.Value, message.Id, isResolved);
        _error = result.Succeeded ? null : result.FirstError ?? "ذخیره وضعیت انجام نشد.";

        // Reload so the page always shows what is persisted.
        _conversation = await Conversations.GetAsync(CustomerId.Value);
    }
}
