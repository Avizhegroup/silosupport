@page "/Account/Login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>ورود</PageTitle>

@* Static server rendering: the form posts to /Account/LoginPost, so native inputs styled with the Telerik theme classes are used here. *@
<div class="login-card">
    <div class="login-brand">S</div>
    <h1>پشتیبانی سیلو</h1>
    <p class="login-sub">ورود مدیر سیستم</p>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="login-error" role="alert">@Error</div>
    }

    <form method="post" action="/Account/LoginPost">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

        <label for="username">نام کاربری</label>
        <input id="username" name="username" type="text" class="k-input k-input-md k-rounded-md k-input-solid" autocomplete="username" required />

        <label for="password">رمز عبور</label>
        <input id="password" name="password" type="password" class="k-input k-input-md k-rounded-md k-input-solid" autocomplete="current-password" required />

        <button type="submit" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary">ورود</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private string SafeReturnUrl => SiloSupport.Web.Security.ReturnUrlHelper.Resolve(ReturnUrl);
}
