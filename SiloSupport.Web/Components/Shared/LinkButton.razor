<a class="@CssClass" href="@Href">@ChildContent</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";

    /// <summary>Primary (filled) or secondary (outlined) look, using the Telerik theme classes.</summary>
    [Parameter] public bool Primary { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string CssClass => Primary
        ? "k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary"
        : "k-button k-button-md k-rounded-md k-button-outline k-button-outline-base";
}
