@inject NavigationManager Navigation

<TelerikButton OnClick="Go"
               ThemeColor="@(Primary ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
               FillMode="@(Primary ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline)">
    @ChildContent
</TelerikButton>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";

    /// <summary>Primary (filled) or secondary (outlined) look.</summary>
    [Parameter] public bool Primary { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Go() => Navigation.NavigateTo(Href);
}
