@if (Missing.Count > 0)
{
    <div class="banner banner-warning" role="alert">
        گروه اولویت تنظیم‌نشده: <strong>@string.Join("، ", Missing.Select(PriorityHelper.DisplayName))</strong>.
        تا زمانی که این گروه‌ها تنظیم نشوند، پیام‌هایی که با این اولویت طبقه‌بندی می‌شوند ارسال نخواهند شد.
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GroupPriority> Missing { get; set; } = Array.Empty<GroupPriority>();
}
