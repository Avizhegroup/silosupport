@if (Missing.Count > 0)
{
    <div class="banner banner-warning" role="alert">
        Missing priority group@(Missing.Count > 1 ? "s" : ""): <strong>@string.Join(", ", Missing)</strong>.
        Messages classified with @(Missing.Count > 1 ? "these priorities" : "this priority") cannot be forwarded until
        @(Missing.Count > 1 ? "they are" : "it is") configured.
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GroupPriority> Missing { get; set; } = Array.Empty<GroupPriority>();
}
